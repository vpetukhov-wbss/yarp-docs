  "title": "Configuration filters",
  "lede": "Modify routes and clusters right after they're loaded and before they're validated - fill in values from the environment, apply defaults, or enforce policies across every entry.",
  "headings": [
    {
      "id": "what-filters-are-for",
      "text": "What filters are for",
      "level": 2
    },
    {
      "id": "registering-a-filter",
      "text": "Registering a filter",
      "level": 2
    },
